<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cyber_dark"
    android:padding="24dp">

    <!-- Emergency Shield Icon -->
    <ImageView
        android:id="@+id/ivLostShield"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginTop="32dp"
        android:tint="@color/cyber_danger"
        android:src="@android:drawable/ic_dialog_alert"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Lost Mode Title -->
    <TextView
        android:id="@+id/tvLostTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/lost_mode_title"
        android:textColor="@color/cyber_danger"
        android:textSize="22sp"
        android:textStyle="bold"
        android:letterSpacing="0.05"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivLostShield" />

    <TextView
        android:id="@+id/tvLostSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/lost_mode_subtitle"
        android:textColor="@color/text_secondary"
        android:textSize="12sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvLostTitle" />

    <!-- Card Container for Custom Owner Message -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/cardMessage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        app:cardBackgroundColor="@color/cyber_surface"
        app:cardCornerRadius="16dp"
        app:strokeColor="@color/cyber_danger"
        app:strokeWidth="1.5dp"
        app:layout_constraintTop_toBottomOf="@id/tvLostSubtitle">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MESSAGE FROM OWNER"
                android:textColor="@color/cyber_danger"
                android:textSize="11sp"
                android:textStyle="bold"
                android:letterSpacing="0.1" />

            <TextView
                android:id="@+id/tvCustomMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="This smartphone has been reported lost. Please contact the verified owner."
                android:textColor="@color/text_primary"
                android:textSize="16sp"
                android:textStyle="bold"
                android:lineSpacingExtra="4dp" />

            <TextView
                android:id="@+id/tvRecoveryNotes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="A generous reward is offered upon safe return to the owner."
                android:textColor="@color/text_secondary"
                android:textSize="13sp"
                android:fontFamily="sans-serif-light" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Emergency Owner Dialer Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCallOwner"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="20dp"
        android:backgroundTint="@color/cyber_success"
        android:text="@string/call_owner_button"
        android:textColor="@color/cyber_dark"
        android:textSize="14sp"
        android:textStyle="bold"
        app:cornerRadius="14dp"
        app:icon="@android:drawable/ic_menu_call"
        app:iconTint="@color/cyber_dark"
        app:layout_constraintTop_toBottomOf="@id/cardMessage" />

    <!-- Owner Local PIN Unlock Section -->
    <LinearLayout
        android:id="@+id/layoutPinUnlock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="OWNER PIN UNLOCK"
            android:textColor="@color/text_secondary"
            android:textSize="11sp"
            android:letterSpacing="0.08" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/etPin"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@color/cyber_surface"
                android:hint="@string/unlock_pin_hint"
                android:inputType="numberPassword"
                android:maxLength="6"
                android:paddingHorizontal="16dp"
                android:textColor="@color/text_primary"
                android:textColorHint="@color/text_secondary"
                android:textSize="14sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnUnlock"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:backgroundTint="@color/cyber_cyan"
                android:text="@string/unlock_button"
                android:textColor="@color/cyber_dark"
                android:textStyle="bold"
                app:cornerRadius="8dp" />

        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:text="GPS coordinates actively streaming to owner dashboard."
            android:textColor="@color/text_secondary"
            android:textSize="10sp" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
