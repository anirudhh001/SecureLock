# ==============================================================================
# SecureLock Project MDC2026 — Root Environment Template
# ==============================================================================
# Copy to .env in this directory or in web/.env for the web frontend.

# Map Provider (Uses OpenStreetMap by default - No API Key Required)
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Firebase Client Configuration (Web Console)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
